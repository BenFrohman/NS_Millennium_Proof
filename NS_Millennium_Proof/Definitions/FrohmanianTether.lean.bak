module

public import NS_Millennium_Proof.Modules.SymplecticTether

/-!
# Central Definitions / Naming for the Frohmanian Tether (Canonical)

Core object: `FrohmanianTether` / 𝔉𝕋  
Main theorem: `frohmanian_tether_theorem` (GlobalRegularity)  
Broader version: `SymplecticTetherTheorem`

Implementations live in `Modules/SymplecticTether.lean` (namespace `FrohmanianTether`)
and `Modules/Uniqueness.lean`.
-/

namespace FrohmanianTether

-- Canonical noncomputable identifier
noncomputable abbrev FrohmanianTether := TetheredBracket

-- Notation 𝔉𝕋
notation "𝔉𝕋" => FrohmanianTether

end FrohmanianTether
