        <div class="bg-white border border-slate-200 rounded-3xl p-6">
            <div class="prose prose-sm max-w-none text-slate-600">
                <p class="text-sm">The following Manim (Python) scenes provide <strong>separate, living (animated)</strong> visualizations of individual terms in the proof. They are designed to be run independently so that each key mathematical object or identity can be presented and inspected on its own (as requested in the referenced shared conversation).</p>
            </div>

            <div class="mt-4 grid grid-cols-1 lg:grid-cols-2 gap-5">
                <!-- Manim Scene 1 -->
                <div class="border border-slate-100 rounded-2xl p-4 bg-slate-50">
                    <div class="flex justify-between items-start">
                        <div>
                            <div class="font-semibold text-sm">Scene 1: Separate 5-Step Canonicity Flow</div>
                            <div class="text-emerald-700 text-xs">Layer 1 geometric forcing (animated steps)</div>
                        </div>
                        <span class="text-[10px] px-2 py-0.5 bg-emerald-100 text-emerald-700 rounded">manim</span>
                    </div>
                    
                    <pre class="mt-3 text-[10px] bg-white border border-slate-200 p-3 rounded-xl overflow-auto font-mono text-slate-700"><code>from manim import *

class SeparateFiveStepCanonicity(Scene):
    def construct(self):
        title = Text("5-Step Canonicity of the Frohmanian Symplectic Tether", font_size=28).to_edge(UP)
        self.play(Write(title))
        
        steps = VGroup(
            Text("1. C1: Locality / Invariance (only |ω|² pointwise)", font_size=18),
            Text("2. C2: Degeneracy on H via Π_u", font_size=18),
            Text("3. C3: Negative quadratic feedback (κ = C_CZ(3))", font_size=18),
            Text("4. Coefficient fixed", font_size=18),
            Text("5. Higher-order exclusion", font_size=18),
        ).arrange(DOWN, aligned_edge=LEFT, buff=0.35).shift(UP*0.5)
        
        for i, step in enumerate(steps):
            self.play(Write(step), run_time=0.6)
            if i &lt; len(steps) - 1:
                arrow = Arrow(step.get_bottom(), steps[i+1].get_top(), buff=0.1, color=BLUE)
                self.play(GrowArrow(arrow), run_time=0.4)
                self.wait(0.3)
        
        self.wait(2)
        self.play(FadeOut(steps), FadeOut(title))</code></pre>
                    <div class="text-xs text-slate-500 mt-1">Run: <span class="font-mono bg-white px-1.5 py-0.5 border">manim -pql scripts/living_pde_visuals.py SeparateFiveStepCanonicity</span></div>
                </div>

                <!-- Manim Scene 2 -->
                <div class="border border-slate-100 rounded-2xl p-4 bg-slate-50">
                    <div class="flex justify-between items-start">
                        <div>
                            <div class="font-semibold text-sm">Scene 2: Living Majorant Phase-Plane + Absorption</div>
                            <div class="text-emerald-700 text-xs">Layer 2 analytic closure (independent majorant)</div>
                        </div>
                        <span class="text-[10px] px-2 py-0.5 bg-emerald-100 text-emerald-700 rounded">manim</span>
                    </div>
                    
                    <pre class="mt-3 text-[10px] bg-white border border-slate-200 p-3 rounded-xl overflow-auto font-mono text-slate-700"><code>from manim import *

class LivingMajorantPhasePlane(Scene):
    def construct(self):
        axes = Axes(x_range=[0, 3], y_range=[0, 4], 
                    axis_config={"color": BLUE})
        self.play(Create(axes))
        
        # The comparison ODE curve
        curve = axes.plot(lambda t: 1.2*t**2 - 0.4*t**3, 
                          color=RED, x_range=[0, 2.5])
        label = MathTex(r"y' = C y^2 - \kappa'' y^3 + \frac{\varepsilon=\kappa}{4} C_{abs}").next_to(curve, UP)
        
        self.play(Create(curve), Write(label))
        
        # Absorption region
        region = axes.get_area(curve, x_range=[1.5, 2.5], color=GREEN, opacity=0.3)
        self.play(FadeIn(region))
        
        brace = Brace(region, direction=DOWN)
        self.play(Write(brace), Write(Text("Quartic absorption closes estimate", font_size=20).next_to(brace, DOWN)))
        
        self.wait(3)</code></pre>
                    <div class="text-xs text-slate-500 mt-1">Emphasizes the independent majorant introduced first (non-circular).</div>
