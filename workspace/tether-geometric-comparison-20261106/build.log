@shearY_jacobi_holds : ∀ {κ w : ℂ} {a b c : Fld},
  XOnly a → DivergenceFree a → XOnly b → DivergenceFree b → XOnly c → DivergenceFree c → jacT κ w uY a b c = 0
@shearY_jacobi_fails_transverse : ∀ {κ w : ℂ}, κ * w ≠ 0 → jacT κ w uY aZ aZ aZ ≠ 0
@jacT_eq_mixedSum : ∀ {u : Fld}, pr u u ≠ 0 → ∀ (κ w : ℂ) (a b c : Fld), jacT κ w u a b c = mixedSumF κ w u a b c
'Frohman.Tether.FieldJacobi.shearY_jacobi_holds' depends on axioms: [propext, Classical.choice, Quot.sound]
