def NS_Millennium_Proof.Semantics.PaperUniformEnvelope : ℝ → Prop :=
fun ν =>
  ∀ (u₀ : NavierStokes3D.VelocityField),
    ContDiff ℝ (↑⊤) u₀ →
      (∀ (x : NavierStokes3D.T3), NavierStokes3D.div u₀ x = 0) →
        NavierStokes3D.IsZ3Periodic u₀ →
          ∃ C k,
            0 < C ∧
              0 < k ∧
                ∀ (T : ℝ) (u : NavierStokes3D.TimeDependentVelocity) (p : NavierStokes3D.TimeDependentPressure),
                  FrohmanianTether.ClayStatements.IsPeriodicSmoothSolutionOn ν T u₀ u p →
                    ∀ (t : ℝ),
                      0 ≤ t →
                        t < T →
                          NavierStokes3D.vorticity_sup_norm (NavierStokes3D.vorticity (u t)) ≤
                            max (NavierStokes3D.vorticity_sup_norm (NavierStokes3D.vorticity (u 0))) (C / k)
