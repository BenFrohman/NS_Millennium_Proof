info: NS_Millennium_Proof.lean:89:0: TRUTH GATE OBSERVE ConditionalGlobalRegularity: paper_claim [main.tex § §1 Introduction, Theorem 1.1 (thm:main)] := ∀
  (ν : ℝ) (u₀ : NavierStokes3D.VelocityField) (u : NavierStokes3D.TimeDependentVelocity)
  (p : NavierStokes3D.TimeDependentPressure) (C κ'' : ℝ),
  0 < ν →
    ContDiffOn ℝ (↑⊤) (fun q ↦ u q.1 q.2) (Set.Ici 0 ×ˢ Set.univ) →
      ContDiffOn ℝ (↑⊤) (fun q ↦ p q.1 q.2) (Set.Ici 0 ×ˢ Set.univ) →
        (NavierStokes3D.navier_stokes_eq_Ici u p ν fun x x_1 ↦ 0) →
          u 0 = u₀ →
            (∀ t ≥ 0, NavierStokes3D.IsZ3Periodic (u t) ∧ NavierStokes3D.IsZ3Periodic (p t)) →
              0 < C →
                0 < κ'' →
                  (∀ s ≥ 0,
                      DifferentiableAt ℝ (fun τ ↦ NavierStokes3D.vorticity_sup_norm (NavierStokes3D.vorticity (u τ)))
                        s) →
                    (∀ s ≥ 0,
                        deriv (fun τ ↦ NavierStokes3D.vorticity_sup_norm (NavierStokes3D.vorticity (u τ))) s ≤
                          C * NavierStokes3D.vorticity_sup_norm (NavierStokes3D.vorticity (u s)) ^ 2 -
                            κ'' * NavierStokes3D.vorticity_sup_norm (NavierStokes3D.vorticity (u s)) ^ 3) →
                      ∀ t ≥ 0,
                        NavierStokes3D.vorticity_sup_norm (NavierStokes3D.vorticity (u t)) ≤
                          max (NavierStokes3D.vorticity_sup_norm (NavierStokes3D.vorticity (u 0))) (C / κ'')
