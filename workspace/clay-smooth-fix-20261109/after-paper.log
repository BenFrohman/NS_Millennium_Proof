pd_pd_comm : ∀ (f : E3 → ℝ), ContDiff ℝ 2 f → ∀ (i j : Fin 3) (x : E3), pd (pd f j) i x = pd (pd f i) j x
div_curl_eq_zero : ∀ (v : E3 → E3), (∀ (a : Fin 3), ContDiff ℝ 2 fun y => v y a) → DivFree (curl v)
curl_differentiable_of_C2 : ∀ (v : E3 → E3), (∀ (a : Fin 3), ContDiff ℝ 2 fun y => v y a) → Differentiable ℝ (curl v)
@spatialC2_of_NSOn : ∀ {ν : ℝ} {S : Set ℝ} {u0 : E3 → E3} {u : ℝ → E3 → E3} {p : ℝ → E3 → ℝ},
  NSOn ν S u0 u p → ∀ {t : ℝ}, t ∈ S → ∀ (a : Fin 3), ContDiff ℝ 2 fun y => u t y a
norm_direction_derivative : ∀ (v : E3 → E3) (x : E3),
  DifferentiableAt ℝ (curl v) x →
    curl v x ≠ 0 →
      ∑ i : Fin 3, pd (fun y => curl v y i) i x = 0 →
        (fderiv ℝ (fun y => ‖curl v y‖) x) (direction v x) = -‖curl v x‖ * directionDivergence v x
@logDerivativeAlong_of_spatialC2 : ∀ {u : ℝ → E3 → E3} {T : ENNReal} (P : Packet u T),
