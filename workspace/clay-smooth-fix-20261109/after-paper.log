@bkmIntegralFinite_of_spatialComparison_and_endpoint : ∀ {u : ℝ → E3 → E3} {T : ENNReal} (P : Packet u T),
  SpatialComparison P → EndpointIntegralFinite P → BKMIntegralFinite u T
