import MetriplecticTetherModel.Energy

/-!
# MetriplecticTetherModel.Dynamics

The tether correction generated by the kinetic energy vanishes identically, so the metriplectic
tether model on `𝕋³` and the incompressible Navier–Stokes equations on `𝕋³` have the same weak
right-hand side, the same smooth solutions, and equivalent global-regularity statements, for every
tether strength `κ` and viscosity `ν`.
-/

open MeasureTheory

namespace MetriplecticTetherModel

theorem FlowField.continuous (u : FlowField) : Continuous u.u := u.smooth.continuous

/-- The tether term in the modified equation vanishes for every state and test field. -/
theorem tether_term_vanishes (κ : ℝ) (u : FlowField) (a : TestField) :
    tether κ (curl u.u) u.u a.v u.u = 0 :=
  tether_energy_slot_right κ _ _ u.continuous

/-- The modified weak right-hand side equals the Navier–Stokes one. -/
theorem tetheredRHS_eq_nsRHS (κ ν : ℝ) (u : FlowField) (a : TestField) :
    tetheredRHS κ ν u a = nsRHS ν u a := by
  rw [tetheredRHS, tether_term_vanishes, add_zero]

theorem tetheredRHS_fun_eq (κ ν : ℝ) : tetheredRHS κ ν = nsRHS ν := by
  funext u a
  exact tetheredRHS_eq_nsRHS κ ν u a

/-- A curve solves the metriplectic tether model iff it solves Navier–Stokes. -/
theorem isSolution_tethered_iff (κ ν : ℝ) (U : ℝ → FlowField) :
    IsSolution (tetheredRHS κ ν) U ↔ IsSolution (nsRHS ν) U := by
  rw [tetheredRHS_fun_eq]

/-- Global regularity of the tether model is equivalent to that of Navier–Stokes on `𝕋³`. -/
theorem globalRegularity_tethered_iff (κ ν : ℝ) :
    GlobalRegularity (tetheredRHS κ ν) ↔ GlobalRegularity (nsRHS ν) := by
  rw [tetheredRHS_fun_eq]

/-- Any property of solutions (e.g. a differential inequality for `‖ω‖_∞` or the enstrophy)
holds for all solutions of the tether model iff it holds for all Navier–Stokes solutions. -/
theorem solution_property_transfer (κ ν : ℝ) (P : (ℝ → FlowField) → Prop) :
    (∀ U, IsSolution (tetheredRHS κ ν) U → P U) ↔ (∀ U, IsSolution (nsRHS ν) U → P U) := by
  simp only [isSolution_tethered_iff]

end MetriplecticTetherModel
