import Mathlib.Analysis.InnerProductSpace.PiL2
import Mathlib.MeasureTheory.Integral.Bochner.Set
import Mathlib.MeasureTheory.Function.LocallyIntegrable
import Mathlib.MeasureTheory.Measure.Lebesgue.Basic
import Mathlib.Analysis.Calculus.ContDiff.Basic
import Mathlib.Analysis.Calculus.Deriv.Pow

/-!
# MetriplecticTetherModel.Basic

Definitions for the metriplectic tether model on the flat torus `𝕋³ = ℝ³/ℤ³`.

* Fields on `𝕋³` are represented as `ℤ³`-periodic maps `ℝ³ → ℝ³`; integrals over `𝕋³` are
  integrals over the fundamental cell `[0,1]³` with Lebesgue measure (`μ`, total mass `1`).
* `curl`, `div`, the Laplacian and the convective derivative `(u·∇)u` are defined from the
  Fréchet derivative `fderiv`.
* `proj u v = v − (⟨v,u⟩/⟨u,u⟩) u` is the `L²(𝕋³)` projection orthogonal to `u`.
* `tether κ ω u a b = −κ ∫ |ω|² (Π_u a · Π_u b)` is the velocity-slot Frohmanian tether
  (symmetric degenerate metric correction), evaluated on `L²` gradients `a = δF/δu`, `b = δG/δu`.
* `nsRHS ν u a` is the weak (divergence-free test field) right-hand side of the incompressible
  Navier–Stokes equations on `𝕋³` with zero forcing; `tetheredRHS κ ν u a` adds the tether
  correction generated by the kinetic energy `H(u) = ½‖u‖²`, whose `L²` gradient is `u`.
-/

open MeasureTheory
open scoped ContDiff

namespace MetriplecticTetherModel

/-- Coordinates of `ℝ³` (also used for field values). -/
abbrev R3 : Type := Fin 3 → ℝ

/-- The fundamental cell `[0,1]³` of `𝕋³ = ℝ³/ℤ³`. -/
def cell : Set R3 := Set.univ.pi fun _ => Set.Icc (0 : ℝ) 1

/-- Lebesgue measure on the fundamental cell, i.e. the Haar probability measure of `𝕋³`. -/
noncomputable def μ : Measure R3 := volume.restrict cell

/-- Euclidean dot product of two vectors of `ℝ³`. -/
def dot (p q : R3) : ℝ := ∑ i, p i * q i

/-- `ℤ³`-periodicity: invariance under the three unit translations. -/
def IsPeriodic (f : R3 → R3) : Prop :=
  ∀ (i : Fin 3) (x : R3), f (x + Pi.single i 1) = f x

/-- Partial derivative `∂ⱼ f` (Fréchet derivative in the direction `eⱼ`). -/
noncomputable def pd (f : R3 → R3) (j : Fin 3) (x : R3) : R3 :=
  fderiv ℝ f x (Pi.single j 1)

/-- Curl: `(∂₁f₂ − ∂₂f₁, ∂₂f₀ − ∂₀f₂, ∂₀f₁ − ∂₁f₀)` (coordinates indexed `0,1,2`). -/
noncomputable def curl (f : R3 → R3) (x : R3) : R3 :=
  ![pd f 1 x 2 - pd f 2 x 1, pd f 2 x 0 - pd f 0 x 2, pd f 0 x 1 - pd f 1 x 0]

/-- Divergence `∑ᵢ ∂ᵢfᵢ`. -/
noncomputable def div (f : R3 → R3) (x : R3) : ℝ := ∑ i, pd f i x i

/-- Laplacian `∑ᵢ ∂ᵢ∂ᵢ f`. -/
noncomputable def laplacian (f : R3 → R3) (x : R3) : R3 :=
  ∑ i, pd (pd f i) i x

/-- Convective derivative `(u·∇)u`. -/
noncomputable def convective (u : R3 → R3) (x : R3) : R3 := fderiv ℝ u x (u x)

/-- A smooth, `ℤ³`-periodic, divergence-free velocity field on `𝕋³`. -/
structure FlowField where
  /-- the velocity field -/
  u : R3 → R3
  smooth : ContDiff ℝ ∞ u
  periodic : IsPeriodic u
  divFree : ∀ x, div u x = 0

/-- A smooth, `ℤ³`-periodic, divergence-free test field on `𝕋³`. -/
structure TestField where
  /-- the test field -/
  v : R3 → R3
  smooth : ContDiff ℝ ∞ v
  periodic : IsPeriodic v
  divFree : ∀ x, div v x = 0

/-- `L²(𝕋³)` pairing `⟨f, g⟩ = ∫_{𝕋³} f · g`. -/
noncomputable def l2 (f g : R3 → R3) : ℝ := ∫ x, dot (f x) (g x) ∂μ

/-- `L²(𝕋³)` projection orthogonal to `u`: `Π_u v = v − (⟨v,u⟩/⟨u,u⟩) u`
(for `⟨u,u⟩ = 0` Lean's `x/0 = 0` gives `Π_u v = v`). -/
noncomputable def proj (u v : R3 → R3) : R3 → R3 :=
  fun x => v x - (l2 v u / l2 u u) • u x

/-- Velocity-slot Frohmanian tether `B(a,b) = −κ ∫_{𝕋³} |ω|² (Π_u a · Π_u b)`. -/
noncomputable def tether (κ : ℝ) (w u a b : R3 → R3) : ℝ :=
  -κ * ∫ x, dot (w x) (w x) * dot (proj u a x) (proj u b x) ∂μ

/-- Kinetic energy `H(u) = ½ ∫_{𝕋³} |u|²`. -/
noncomputable def energy (u : R3 → R3) : ℝ := (1 / 2) * l2 u u

/-- Weak Navier–Stokes right-hand side on `𝕋³` (zero forcing; no pressure term, the weak form
being tested only against divergence-free periodic fields):
`⟨∂ₜu, a⟩ = −⟨(u·∇)u, a⟩ + ν ⟨Δu, a⟩`. -/
noncomputable def nsRHS (ν : ℝ) (u : FlowField) (a : TestField) : ℝ :=
  -l2 (convective u.u) a.v + ν * l2 (laplacian u.u) a.v

/-- Tethered (metriplectic tether model) weak right-hand side:
`⟨∂ₜu, a⟩ = −⟨(u·∇)u, a⟩ + ν⟨Δu, a⟩ + B_ω(a, δH/δu)`, with `ω = curl u` and `δH/δu = u`. -/
noncomputable def tetheredRHS (κ ν : ℝ) (u : FlowField) (a : TestField) : ℝ :=
  nsRHS ν u a + tether κ (curl u.u) u.u a.v u.u

/-- `U` is a smooth solution on `[0, ∞)` of the weak system with right-hand side `rhs`:
jointly `C^∞` in `(t, x)` on `[0,∞) × ℝ³`, and for every test field `a` and every `t > 0`,
`d/dt ⟨U(t), a⟩ = rhs (U t) a`. -/
def IsSolution (rhs : FlowField → TestField → ℝ) (U : ℝ → FlowField) : Prop :=
  ContDiffOn ℝ ∞ (fun p : ℝ × R3 => (U p.1).u p.2) (Set.Ici 0 ×ˢ Set.univ) ∧
  ∀ (a : TestField) (t : ℝ), 0 < t →
    HasDerivAt (fun s => l2 (U s).u a.v) (rhs (U t) a) t

/-- Global regularity: every smooth periodic divergence-free initial velocity is the time-`0`
value of a smooth solution on `[0, ∞)`. -/
def GlobalRegularity (rhs : FlowField → TestField → ℝ) : Prop :=
  ∀ u₀ : FlowField, ∃ U : ℝ → FlowField, (U 0).u = u₀.u ∧ IsSolution rhs U

end MetriplecticTetherModel
