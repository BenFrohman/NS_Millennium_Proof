+-- An all-zero length profile cannot certify ANY nonzero-vorticity field.
+example {u : ℝ → E3 → E3} {T : ℝ≥0∞} (P : Packet u T)
+    (hL : ∀ t, P.length t = 0) {t : ℝ} (ht : t ∈ lifespanSet T) (x : E3) :
+    curl (u t) x = 0 :=
+  curl_eq_zero_of_length_eq_zero P ht (hL t) x
+
